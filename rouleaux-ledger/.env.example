# Rouleaux Ledger Environment Variables

# Database Configuration
# For SQLite (development):
DATABASE_URL="sqlite:./rouleaux.db"

# For PostgreSQL (production):
# DATABASE_URL="postgres://username:password@localhost:5432/rouleaux"

# Server Configuration
ROULEAUX_PORT=3001

# Logging Level (debug, info, warn, error)
RUST_LOG="rouleaux_ledger=info,tower_http=info"

# Optional: Enable proof-of-work for transactions (difficulty level)
# PROOF_OF_WORK_DIFFICULTY=2

# Optional: Maximum transactions per query
MAX_QUERY_LIMIT=1000

# Optional: Enable CORS for specific origins (comma-separated)
# CORS_ORIGINS="https://trustescrow.com,https://app.trustescrow.com"
